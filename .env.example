# Copy to .env (git-ignored). Never commit real credentials.

# ---- ClinicOps backend ----
PORT=3001
# JWT_SECRET and PII_ENCRYPTION_KEY must each be at least 32 characters.
# If omitted outside production, server.mjs generates local git-ignored files.
# JWT_SECRET=
# PII_ENCRYPTION_KEY=

# ---- ABDM / ABHA (Milestone 1) ----
# Without these two values every /api/abha/* route returns 503 ABDM_NOT_CONFIGURED.
# Apply for sandbox credentials at https://sandbox.abdm.gov.in
ABDM_ENVIRONMENT=sandbox
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# Optional overrides (defaults depend on ABDM_ENVIRONMENT)
# sandbox session:    https://dev.abdm.gov.in/gateway/v3/sessions
# production session: https://apis.abdm.gov.in/gateway/v3/sessions
# sandbox ABHA base:  https://abhasbx.abdm.gov.in/abha/api
# production ABHA:    https://abha.abdm.gov.in/abha/api
# ABDM_SESSION_URL=
# ABDM_ABHA_BASE_URL=
# ABDM_TIMEOUT_MS=20000

# ---- Database Configuration ----
# Staging/Production: PostgreSQL URL
# DATABASE_URL=postgresql://user:password@localhost:5432/clinicops
# Development fallback SQLite path:
# DB_FILE=./clinicops.db

# ---- Text-to-Speech (Sarvam AI Multilingual) ----
# Primary neural TTS provider (en-IN, hi-IN, mr-IN, bn-IN)
# SARVAM_API_KEY=

